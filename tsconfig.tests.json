{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": ".test-build",
    "types": [
      "node"
    ],
    "noEmitOnError": true
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts"
  ]
}
